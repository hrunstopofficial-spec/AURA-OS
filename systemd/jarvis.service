[Unit]
Description=JARVIS Autonomous Cloud Agent & Telegram Gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/jarvis-core
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u tools/telegram_bridge.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
